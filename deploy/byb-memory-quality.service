[Unit]
Description=Read-only daily Watson memory quality checks
After=memory.backyardbrains.com.service docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/memory.backyardbrains.com
EnvironmentFile=/root/memory-api-database.env
Environment=PYTHONPATH=/var/www/memory.backyardbrains.com
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=2
ExecStart=/var/www/memory.backyardbrains.com/venv/bin/python -m scripts.memory_quality_check
Nice=10
CPUQuota=150%
MemoryMax=2G
TimeoutStartSec=300
